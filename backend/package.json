{
  "name": "care-dashboard-api",
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "db:seed": "nest build && node --env-file-if-exists=.env dist/seed.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/seeder": "^7.2.1",
    "@mikro-orm/sqlite": "^7.2.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mikro-orm/cli": "^7.2.1",
    "@nestjs/cli": "^12.0.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "@scarf/scarf": false
  }
}
