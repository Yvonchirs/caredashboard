NODE_ENV=production
PORT=4000
HOST=127.0.0.1
DB_NAME=/opt/caredashboard/data/care-dashboard.sqlite3
CORS_ORIGIN=http://10.10.80.244:3001
JWT_SECRET=<generate with: openssl rand -hex 32>
# Address of the dashboard as users open it, used in emailed links
APP_URL=https://dashboard.care.org.rw
# Outgoing email (SMTP). Without SMTP_HOST, emails are only written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CARE Rwanda Activity Board <no-reply@care.org.rw>"
