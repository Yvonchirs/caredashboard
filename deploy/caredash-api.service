[Unit]
Description=CARE Rwanda Activity Dashboard - API
After=network.target

[Service]
User=caredash
Group=caredash
WorkingDirectory=/opt/caredashboard/app/backend
EnvironmentFile=/opt/caredashboard/shared/api.env
Environment=PATH=/opt/caredashboard/node/bin:/usr/bin:/bin
ExecStart=/opt/caredashboard/node/bin/node dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/caredashboard/data

[Install]
WantedBy=multi-user.target
